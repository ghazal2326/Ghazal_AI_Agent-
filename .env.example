# ============================================================
# PERSONAL AI AGENT SYSTEM — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values
# cp .env.example .env

# --- OpenAI API (Required for AI features) ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Gmail / Google OAuth (Required for Email agent) ---
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → Enable Gmail API + Google People API
# 3. Create OAuth 2.0 credentials (Desktop app)
# 4. Download credentials.json and place it in this folder
GMAIL_CREDENTIALS_FILE=credentials.json

# --- Flask Secret Key (change this to a random string) ---
FLASK_SECRET_KEY=change-me-to-a-random-secret-key-123

# --- App Settings ---
APP_PORT=8765
DEBUG=false
